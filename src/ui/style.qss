* {
    font-family: "Segoe UI Variable Text", "Segoe UI";
    font-size: 10pt;
    color: #e6e8ee;
}

#central, #detail, QStackedWidget { background: #14161b; }

#topBar {
    background: #14161b;
    border-bottom: 1px solid #23272f;
}
#wordmark { font-size: 13pt; font-weight: 600; letter-spacing: 0.3px; }

#libraryPanel {
    background: #181b21;
    border-right: 1px solid #23272f;
}

QListWidget { background: transparent; outline: none; }
QListWidget::item { border: none; }

#sectionLabel {
    color: #7d8593;
    font-size: 8pt;
    font-weight: 700;
    letter-spacing: 1.4px;
}
#muted { color: #8b93a1; }
#path { color: #5f6775; font-size: 9pt; }
#emptyTitle { font-size: 18pt; font-weight: 600; }
#gameTitle { font-size: 21pt; font-weight: 600; }

#badgeClean, #badgeModified {
    font-size: 7.5pt;
    font-weight: 700;
    letter-spacing: 0.8px;
    padding: 2px 9px;
    border-radius: 9px;
}
#badgeClean { color: #4fd18b; background: rgba(46, 160, 98, 0.16); }
#badgeModified { color: #f0a43a; background: rgba(230, 150, 40, 0.18); }

QPushButton {
    border-radius: 8px;
    padding: 8px 16px;
    font-weight: 600;
}
QPushButton#play, QPushButton#primary {
    background: #f5b800;
    color: #16130a;
    padding: 11px 30px;
    font-size: 11pt;
}
QPushButton#play:hover, QPushButton#primary:hover { background: #ffc81f; }
QPushButton#play:pressed, QPushButton#primary:pressed { background: #d9a300; }
QPushButton#play:disabled { background: #3a3523; color: #9c8d5a; }
QPushButton#secondary { background: #262a33; border: 1px solid #323743; }
QPushButton#secondary:hover { background: #2d323c; }
QPushButton#ghost { background: transparent; color: #aeb5c1; }
QPushButton#ghost:hover { background: #22262e; color: #e6e8ee; }

#card {
    background: #1b1e25;
    border: 1px solid #252932;
    border-radius: 12px;
}
#settingsRow { border-bottom: 1px solid #22262e; }
#rowLabel { font-weight: 600; }
#rowHint { color: #737b89; font-size: 8.5pt; }

QComboBox {
    background: #23272f;
    border: 1px solid #2f3440;
    border-radius: 7px;
    padding: 6px 12px;
}
QComboBox:hover { border-color: #3d4351; }
QComboBox::drop-down { border: none; width: 26px; }
QComboBox::down-arrow { image: url(:/chevron.svg); width: 10px; height: 10px; }
QComboBox QAbstractItemView {
    background: #23272f;
    border: 1px solid #2f3440;
    selection-background-color: #333946;
    outline: none;
    padding: 4px;
}

QCheckBox::indicator {
    width: 38px;
    height: 22px;
    image: url(:/switch-off.svg);
}
QCheckBox::indicator:checked { image: url(:/switch-on.svg); }

QScrollBar:vertical { background: transparent; width: 10px; margin: 4px 2px; }
QScrollBar::handle:vertical { background: #2c313b; border-radius: 3px; min-height: 30px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
QScrollBar::add-page, QScrollBar::sub-page { background: none; }

QMessageBox { background: #1b1e25; }
